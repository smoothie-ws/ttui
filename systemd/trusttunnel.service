# Managed by ttui
[Unit]
Description=TrustTunnel Endpoint
Wants=network-online.target ttui-router.service
After=network-online.target ttui-router.service
ConditionPathExists=/etc/trusttunnel/vpn.toml
ConditionPathExists=/etc/trusttunnel/hosts.toml

[Service]
Type=exec
User=ttui
Group=ttui
WorkingDirectory=/etc/trusttunnel
Environment=TTUI_STATE=/var/lib/ttui
ExecStart=/opt/ttui/venv/bin/python /opt/ttui/app.py --run-endpoint
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
